@base <https://semantic-flow.github.io/mesh-branch-fantasy-rules/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/AbilityScore/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/AbilityScore/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/AbilityScore/_knop/_sources#extraction-source> .

<ontology/AbilityScore/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/_history001/_s0001> ;
  sflo:hasResolutionObservation <ontology/AbilityScore/_knop/_sources#extraction-source-observation-001> .

<ontology/AbilityScore/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetHistoricalState <ontology/_history001/_s0001> ;
    sflo:targetManifestation <ontology/_history001/_s0001/ttl> ;
    sflo:targetLocatedFile <ontology/_history001/_s0001/ttl/fantasy-rules-ontology.ttl>
  ] ;
  sflo:observedContentDigest "sha256:cde2f0ac40fda47f3ecae3a5183825475119129540a3b773950954085f6e9f6f" .

<ontology/AbilityScore/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
