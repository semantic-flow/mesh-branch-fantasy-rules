@base <https://semantic-flow.github.io/mesh-branch-fantasy-rules/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/Alignment/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/Alignment/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/Alignment/_knop/_sources#extraction-source> .

<ontology/Alignment/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology> ;
  sflo:hasArtifactResolutionMode <https://semantic-flow.github.io/sflo/ontology/artifactResolutionMode_working> ;
  sflo:hasResolutionObservation <ontology/Alignment/_knop/_sources#extraction-source-observation-001> .

<ontology/Alignment/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetLocalRelativePath "../source/ontology/fantasy-rules-ontology.ttl"
  ] ;
  sflo:observedContentDigest "sha256:cde2f0ac40fda47f3ecae3a5183825475119129540a3b773950954085f6e9f6f" .

<ontology/Alignment/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
