@base <https://semantic-flow.github.io/mesh-branch-fantasy-rules/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/AlignmentHistory/_knop/_sources> a sflo:KnopSourceRegistry, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <ontology/AlignmentHistory/_knop/_sources/sources.ttl> ;
  sflo:hasSourceBinding <ontology/AlignmentHistory/_knop/_sources#extraction-source> .

<ontology/AlignmentHistory/_knop/_sources#extraction-source> a sflo:ExtractionSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.0.2> ;
  sflo:hasResolutionObservation <ontology/AlignmentHistory/_knop/_sources#extraction-source-observation-001> .

<ontology/AlignmentHistory/_knop/_sources#extraction-source-observation-001> a sflo:ArtifactResolutionObservation ;
  sflo:observedArtifactResolutionSpec [
    a sflo:ArtifactResolutionSpec ;
    sflo:targetHistoricalState <ontology/releases/v0.0.2> ;
    sflo:targetManifestation <ontology/releases/v0.0.2/ttl> ;
    sflo:targetLocatedFile <ontology/releases/v0.0.2/ttl/fantasy-rules-ontology.ttl>
  ] ;
  sflo:observedContentDigest "sha256:f200a39ad022f1954d19527fa2307b1b5e29d8f3b468314488585a7b3ce8457b" .

<ontology/AlignmentHistory/_knop/_sources/sources.ttl> a sflo:LocatedFile, sflo:RdfDocument .
